# Non-secret env for the production cluster, read at deploy time by
# infrastructure-deployment-configuration and turned into the app ConfigMap.
# Every value must fit on a single line: no line continuation, no escapes.
# Secrets live in Passbolt, never here - as does anything multiline.

NODE_OPTIONS=--max-old-space-size=7000
PORT=3000
NODE_ENV=production
# Server-side fetches go to the Strapi service in the same namespace.
NEXT_PUBLIC_STRAPI_URL=marianum-strapi-app
